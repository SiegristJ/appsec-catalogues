{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec.complects.com/schema/references.schema.json",
  "title": "References (data/references.yaml)",
  "description": "All Appendix B tables merged into one list sorted numerically by ID, per SETUP-INSTRUCTIONS 4.3. Each source is recorded once for the whole corpus (4.9).",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "type": "string", "pattern": "^R-\\d+$" },
      "title": { "type": "string" },
      "url": { "type": ["string", "null"] },
      "issuer": { "type": "string" },
      "edition": { "type": "string" },
      "tier": { "type": "integer", "minimum": 1, "maximum": 5 },
      "tier_note": { "type": ["string", "null"] },
      "opened": { "type": "string" },
      "cited_by_text": { "type": "string" },
      "snapshot": {
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "commit": { "type": "string" },
              "retrieved": { "type": "string", "format": "date-time" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "licence": { "type": ["string", "null"] }
            },
            "minProperties": 1
          }
        ]
      }
    },
    "required": ["id", "title", "url", "issuer", "edition", "tier", "tier_note", "opened", "cited_by_text", "snapshot"],
    "additionalProperties": false
  }
}
